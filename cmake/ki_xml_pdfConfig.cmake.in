include(CMakeFindDependencyMacro)
find_dependency(ZLIB)
include("${CMAKE_CURRENT_LIST_DIR}/ki_xml_pdfTargets.cmake")
if(NOT TARGET ki_xml_pdf::ki_xml_pdf)
    add_library(ki_xml_pdf::ki_xml_pdf INTERFACE IMPORTED)
    if(DEFINED ki_xml_pdf_USE_STATIC_LIBS)
        if(ki_xml_pdf_USE_STATIC_LIBS)
            set(_ki_variant static)
        else()
            set(_ki_variant shared)
        endif()
    elseif(@KI_DEFAULT_SHARED@)
        set(_ki_variant shared)
    else()
        set(_ki_variant static)
    endif()
    set_property(TARGET ki_xml_pdf::ki_xml_pdf PROPERTY
                 INTERFACE_LINK_LIBRARIES ki_xml_pdf::${_ki_variant})
    unset(_ki_variant)
endif()
set(ki_xml_pdf_VERSION "@KI_VERSION@")
