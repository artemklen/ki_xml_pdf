set(PACKAGE_VERSION "@KI_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(PACKAGE_FIND_VERSION VERSION_LESS PACKAGE_VERSION AND
       PACKAGE_FIND_VERSION_MAJOR EQUAL @KI_VERSION_MAJOR@ AND
       PACKAGE_FIND_VERSION_MINOR EQUAL @KI_VERSION_MINOR@)
    # Before 1.0, a minor version may change the ABI.
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
